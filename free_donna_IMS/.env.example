# Plantilla de variables de entorno. Copiala a ".env" y completá los valores.
#   cp .env.example .env
# El archivo .env real NO se commitea (está en .gitignore).

# --- Django ---
# Generá una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambiame-por-una-clave-secreta
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de datos PostgreSQL ---
DB_NAME=free_donna_ims_db
DB_USER=fd_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5433

# --- Email ---
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=joaquindores@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=joaquindores@gmail.com
